# k8sgpt Provider Configuration
# Copy this to .env and fill in your values

# ============================================
# OPTION 1: Ollama (Free, Local, Lightweight)
# ============================================
# Best for testing! No API key needed.

K8SGPT_BACKEND=ollama
K8SGPT_MODEL=tinyllama  # 637 MB - fast and lightweight

# Alternative lightweight models:
# K8SGPT_MODEL=qwen2.5:0.5b  # 397 MB - smallest (run: ollama pull qwen2.5:0.5b)
# K8SGPT_MODEL=phi3:mini      # 2.2 GB - better quality (run: ollama pull phi3:mini)

# ============================================
# OPTION 2: OpenAI (Paid, Best Quality)
# ============================================
# Uncomment these and comment out Ollama config above:

# K8SGPT_BACKEND=openai
# K8SGPT_MODEL=gpt-4o-mini  # Cheaper than gpt-4o
# OPENAI_API_KEY=sk-your-key-here

# ============================================
# Other Cloud Providers
# ============================================
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# COHERE_API_KEY=your-key-here

# ============================================
# Kubernetes Configuration
# ============================================
K8SGPT_NAMESPACE=k8sgpt

# Analysis filters (comma-separated)
K8SGPT_FILTERS=Pod,Service,Deployment,ReplicaSet,PersistentVolumeClaim

# Output format: json, yaml, text
K8SGPT_OUTPUT_FORMAT=json
