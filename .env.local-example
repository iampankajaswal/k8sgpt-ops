# Quick Local Testing Config (Lightweight)
# Copy this to .env for fast local testing

# Ollama with tinyllama (637 MB - lightweight and fast)
K8SGPT_BACKEND=ollama
K8SGPT_MODEL=tinyllama

# Kubernetes Configuration
K8SGPT_NAMESPACE=k8sgpt
K8SGPT_FILTERS=Pod,Deployment,Service

# Output
K8SGPT_OUTPUT_FORMAT=json

# To use this config:
# 1. ollama serve (in one terminal)
# 2. ollama pull tinyllama (only 637 MB!)
# 3. cp .env.local-example .env
# 4. make setup && make local-test
